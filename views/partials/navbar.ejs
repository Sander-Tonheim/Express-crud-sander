<nav>
	<div class="logo-container">
		<img
			src="/images/logo.png"
			alt="Logo"
			class="logo-image" />
	</div>
	<ul class="nav-links">
		<% if (session.email) { %>

		<li><a href="/">Hjem</a></li>
		<!-- Dette vises hvis session.user eksisterer -->
		<li>
			<a href="/logout"><button>Sign out</button></a>
		</li>
		<li>
			<a href="/dashboard">Dashboard</a>
		</li>

		<% } else { %>
		<!-- Dette vises hvis brukeren ikke er logget inn -->
		<li><a href="/">Hjem</a></li>
		<li><a href="/signup">Registrer deg</a></li>
		<li><a href="/signin">Logg inn</a></li>
		<% } %>
		<a
			class="get-started-btn"
			href="/signup"
			>Kom i gang
		</a>
	</ul>
</nav>
