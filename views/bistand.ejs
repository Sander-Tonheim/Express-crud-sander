<form method="post">
	<label for="">Bistand</label>
	<input
		name="text"
		type="text" />
	<button type="submit">Submit</button>
</form>
<p>bistand:</p>
<ul>
	<% text.forEach(text => { %>
	<li>
		<p><%= text.question %></p>
	</li>
	<form
		action="/updateQuestion/<%= text.id %>"
		method="post">
		<input
			type="text"
			name="questionUpdateText" />
		<button type="submit">Endre</button>
	</form>
	<% }) %>
</ul>
